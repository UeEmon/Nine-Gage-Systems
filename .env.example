# ---- ログイン ----
# 最初の管理者。ユーザーが1人もいないときだけ作られる（2回目以降は使われない）
NINEGAGE_ADMIN_USER=admin
NINEGAGE_ADMIN_PASSWORD=
# ユーザーとAI設定の保存先（既定 ./data）
# NINEGAGE_DATA_DIR=./data
# http で試すとき（本番は https なので不要）
# NINEGAGE_INSECURE_COOKIE=true

# ---- AI設定（すべて任意。管理者が「管理」画面で設定した値が優先されます）----
# 画面で未選択のときに使うプロバイダ: anthropic | openai | gemini | local
AI_DEFAULT_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# ローカルLLM（OpenAI互換API: Ollama, LM Studio, vLLM, llama.cpp server など）
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_API_KEY=


# ---- ペーパークラフトジェネレーター（任意。docs/PAPERCRAFT_API.md）----
# 「再現してみた」の仮オブジェクトの展開図を作る、別のコンテナのURL。未設定なら展開図のボタンは出ない
# PAPERCRAFT_URL=http://papercraft:8080
# PAPERCRAFT_API_TOKEN=
# PAPERCRAFT_TIMEOUT_MS=30000

# ---- AI設定（すべて任意。画面の「AI設定」から入力することもできます）----
# 画面で未選択のときに使うプロバイダ: anthropic | openai | gemini | local
AI_DEFAULT_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# ローカルLLM（OpenAI互換API: Ollama, LM Studio, vLLM, llama.cpp server など）
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_API_KEY=

# 画面から接続先URLを変更してよいか（本番では既定で false。公開サーバーでは false 推奨）
# AI_ALLOW_CUSTOM_BASE_URL=true
